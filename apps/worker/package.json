{
  "name": "@socialhub/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --declaration false --declarationMap false",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@socialhub/config": "*",
    "@socialhub/db": "*",
    "@socialhub/platform-adapters": "*",
    "@socialhub/security": "*",
    "@socialhub/shared": "*",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
