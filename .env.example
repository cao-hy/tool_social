# =============================================================================
# SocialHub Manager — mẫu biến môi trường
# =============================================================================
#
#   cp .env.example .env
#
# QUY TẮC (prompt §21, SECURITY.md §10):
#   • File này CHỈ chứa placeholder. Không bao giờ điền giá trị thật vào đây.
#   • .env bị .gitignore chặn. Không bao giờ commit nó.
#   • Ở production, lấy secret từ secret manager của nền tảng deploy, không
#     phải từ file.
#   • Mọi biến ở đây được validate lúc khởi động bởi @socialhub/config.
#     Thiếu biến bắt buộc → app chết ngay với thông báo chỉ rõ biến nào.
#
# =============================================================================

# ----------------------------------------------------------------- Chung
NODE_ENV=development
LOG_LEVEL=debug

# ----------------------------------------------------------------- API
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Danh sách origin phân tách bằng dấu phẩy. KHÔNG dùng "*" ở production —
# kết hợp với cookie xác thực là một lỗ hổng (SECURITY.md §9).
CORS_ORIGINS=http://localhost:3000

SESSION_COOKIE_NAME=socialhub.sid
SESSION_MAX_AGE_DAYS=30

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Bật khi chạy sau reverse proxy (nginx, Cloudflare) để đọc đúng IP client.
TRUST_PROXY=false

# ----------------------------------------------------------------- Database
# Khớp với docker/docker-compose.yml
DATABASE_URL=postgresql://socialhub:socialhub_dev_password@localhost:5432/socialhub?schema=public
# Production Docker Compose:
#   POSTGRES_PASSWORD=<strong-password>
#   DATABASE_URL=postgresql://socialhub:<strong-password>@postgres:5432/socialhub?schema=public
# Tuỳ chọn nếu muốn đổi user/db/port bind:
#   POSTGRES_USER=socialhub
#   POSTGRES_DB=socialhub
#   POSTGRES_BIND_ADDRESS=127.0.0.1
#   POSTGRES_PORT=5432
POSTGRES_PASSWORD=socialhub_dev_password

# ----------------------------------------------------------------- Redis
REDIS_URL=redis://localhost:6379
# Production Docker Compose:
#   REDIS_URL=redis://redis:6379
#   REDIS_BIND_ADDRESS=127.0.0.1
#   REDIS_PORT=6379

# ----------------------------------------------------------------- Mã hóa token
#
# SECURITY.md §2. Khóa AES-256 = đúng 32 byte, mã hóa base64.
#
# Sinh khóa mới:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Định dạng nhiều khóa để rotate được mà không phải dừng hệ thống:
#   ENCRYPTION_KEYS=v1:<base64>,v2:<base64>
#   ENCRYPTION_ACTIVE_KEY=v2
# Khóa cũ vẫn nằm trong danh sách cho tới khi job re-encrypt chạy xong.
#
# GIÁ TRỊ DƯỚI ĐÂY LÀ PLACEHOLDER — PHẢI THAY TRƯỚC KHI DÙNG.
ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTE_KEY_GENERATED_LOCALLY==
ENCRYPTION_ACTIVE_KEY=v1

# ----------------------------------------------------------------- Storage (S3-compatible)
# Local/dev: MinIO trong docker/docker-compose.yml.
# Production VPS mặc định: MinIO chạy ngay trên VPS, file nằm trong Docker volume
# minio-data. Tên S3_* chỉ vì MinIO dùng API tương thích S3, KHÔNG bắt buộc dùng AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=socialhub-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO cần path-style; R2/S3 thì đặt false.
S3_FORCE_PATH_STYLE=true
# Production Docker Compose nếu dùng MinIO nội bộ:
#   S3_ENDPOINT=http://minio:9000
#   S3_PUBLIC_BASE_URL=https://media.example.com
#   MINIO_PUBLIC_READ=true
#   MINIO_BIND_ADDRESS=127.0.0.1
#   MINIO_API_PORT=9000
#   MINIO_CONSOLE_PORT=9001
# Reverse proxy:
#   https://media.example.com -> 127.0.0.1:9000
#
# Bắt buộc nếu publish Instagram media hoặc bất kỳ nền tảng nào cần tự fetch
# media: URL này phải public ngoài internet. Với MinIO VPS, bucket cần
# MINIO_PUBLIC_READ=true để social platform tải được object.
# S3_PUBLIC_BASE_URL=https://media.example.com

# ----------------------------------------------------------------- Worker
WORKER_HEALTH_PORT=4001
WORKER_CONCURRENCY_MULTIPLIER=1
SCHEDULER_ENABLED=true

# ----------------------------------------------------------------- Frontend
# CHỈ những biến NEXT_PUBLIC_* mới lộ ra trình duyệt.
# Tuyệt đối không đặt secret ở đây (SECURITY.md §10).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=SocialHub Manager
# Production Docker Compose port bind, thường đặt sau reverse proxy nginx/Caddy:
#   API_BIND_ADDRESS=127.0.0.1
#   API_PORT=4000
#   WEB_BIND_ADDRESS=127.0.0.1
#   WEB_PORT=3000
#   WORKER_BIND_ADDRESS=127.0.0.1

# ----------------------------------------------------------------- Monitoring
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# OAUTH CREDENTIAL CỦA CÁC NỀN TẢNG
# =============================================================================
#
# TẤT CẢ đều OPTIONAL. Hệ thống khởi động được khi chưa có credential nào —
# đúng thực tế của Phase 1–2 và đúng với prompt §21 ("không tự tạo credential
# giả"). Thiếu credential được báo tại thời điểm KẾT NỐI tài khoản, kèm thông
# báo rõ ràng, chứ không chặn cả ứng dụng.
#
# ⚠️ Mỗi nền tảng đều yêu cầu app review / business verification cho scope
#    production. Xem docs/ROADMAP.md §Track B — đây là đường găng thật của dự án.
#
# ⚠️ Danh sách scope cần xin CHƯA được xác minh. Xem
#    docs/SOCIAL_API_CAPABILITIES.md §8 để biết cần tra cứu gì.
# -----------------------------------------------------------------------------

# --- Facebook Pages ---
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Ví dụ định dạng: v24.0. Dùng version bạn đã chọn trong Meta Developer app,
# không để hệ thống tự đoán version Graph API.
# FACEBOOK_WEBHOOK_SECRET=
# FACEBOOK_API_VERSION=
# Nếu app dùng Facebook Login for Business / Use Cases mới, tạo Login Configuration
# trong Meta Dashboard và điền ID ở đây. Khi có biến này, OAuth dùng config_id
# thay vì scope=... để Meta grant đúng permission trong configuration.
# Configuration cần gồm: pages_show_list, pages_read_engagement,
# pages_read_user_content, pages_manage_posts, pages_manage_engagement.
# FACEBOOK_LOGIN_CONFIG_ID=

# --- Instagram Business ---
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# --- Pinterest Business ---
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# Board mặc định để app tạo/chọn khi kết nối Pinterest.
# PINTEREST_DEFAULT_BOARD_NAME=SocialHub
# Trial access phải dùng sandbox. Local dev mặc định sandbox nếu không set biến này.
# Sandbox chỉ hỗ trợ image Pin, không hỗ trợ video Pin.
# PINTEREST_API_ENVIRONMENT=sandbox

# --- YouTube (Google Cloud project) ---
# Authorized JavaScript origin local: http://localhost:3000
# Authorized redirect URI local: http://localhost:4000/api/v1/oauth/youtube/callback
# OAuth scopes cần cấu hình consent: youtube.upload, youtube.readonly,
# youtube.force-ssl. Nếu thêm scope sau khi đã connect, hãy disconnect/connect lại.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# --- TikTok Business ---
# Login Kit for Web yêu cầu redirect URI bắt đầu bằng https.
# Local dev: dùng HTTPS tunnel tới API port 4000, ví dụ:
#   API_BASE_URL=https://your-tunnel.example
#   Redirect URI: https://your-tunnel.example/api/v1/oauth/tiktok/callback
# Content Posting API cần app product + scopes: user.info.basic, video.upload, video.publish.
# Display/metrics dùng thêm scope video.list.
# Nếu TikTok app thiếu scope, OAuth/publish sẽ trả lỗi rõ để user/admin cấu hình lại.
# TikTok video dùng binary upload từ storage private. TikTok photo post thì khác:
# ảnh phải có URL HTTPS public và domain/prefix đã verify trong TikTok Developer Portal.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
