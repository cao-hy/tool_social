{
  "name": "@socialhub/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "generated"
  ],
  "scripts": {
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --declaration false --declarationMap false",
    "lint": "eslint src prisma",
    "test": "vitest run --passWithNoTests",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "db:format": "prisma format",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@socialhub/shared": "*"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
