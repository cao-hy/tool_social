{
  "name": "socialhub-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-platform social media management system",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "predev": "npm run build:runtime-packages",
    "dev": "turbo run dev",
    "build:runtime-packages": "npm run build -w @socialhub/shared && npm run build -w @socialhub/config && npm run build -w @socialhub/security && npm run build -w @socialhub/platform-adapters",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "security:audit": "node scripts/check-audit.mjs",
    "db:generate": "npm run db:generate -w @socialhub/db",
    "db:migrate": "npm run db:migrate -w @socialhub/db",
    "db:seed": "npm run db:seed -w @socialhub/db",
    "db:studio": "npm run db:studio -w @socialhub/db",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@nestjs/platform-fastify@11.1.28": {
      "find-my-way": "9.7.0"
    },
    "brace-expansion": "5.0.8",
    "esbuild": "^0.25.0",
    "find-my-way": "9.7.0",
    "minimatch": "10.2.5",
    "next": {
      "postcss": "^8.5.3",
      "sharp": "0.35.3"
    },
    "postcss": "^8.5.3",
    "sharp": "0.35.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
